# OpenAI-compatible LLM configuration. Do not commit real credentials.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Paths are resolved relative to the backend directory.
CORPUS_DIR=../se-dataset
CHROMA_DIR=.data/chroma

# Only this development frontend origin is allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Qdrant managed vector DB. Leave QDRANT_URL empty to keep the in-memory store.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=customer_chunks
QDRANT_MANIFEST_COLLECTION=customer_manifest
QDRANT_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_DIM=384
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RERANKER=jina
JINA_API_KEY=
RETRIEVE_LIMIT=30
